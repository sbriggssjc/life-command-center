{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "LCC Create Outlook Draft \u2014 org-sanctioned outbound email path. LCC (api/_shared/outlook-draft.js) POSTs a rendered draft here; this flow creates a DRAFT in Outlook under the user's M365 connection. IT NEVER SENDS \u2014 there is no Send action anywhere in this definition, and test/draft-assist.test.mjs asserts that. P124: the flow now BRANCHES on in_reply_to. When present, it resolves the Graph message id from the RFC internetMessageId and calls POST /me/messages/{id}/createReply, which creates a draft reply INSIDE the existing thread (correct conversationId + In-Reply-To/References headers), then PATCHes the body. CreateDraftMessageV3 cannot thread \u2014 it has no header or conversation input \u2014 so a standalone draft is used only when in_reply_to is empty (a genuine new thread). createReply CREATES and does not transmit. The connector's reply/send operations DO transmit and are forbidden here \u2014 test/draft-assist.test.mjs walks every operationId + Uri in this file and fails on any transmitting operation. \u26a0\ufe0f UNVERIFIED AGAINST A LIVE TENANT: operationIds (CreateDraftMessageV3 / HttpRequest) and the $connections reference resolve only on import. Follow docs/architecture/flows/outlook-draft-reply-executor.md and run its acceptance test before flipping DRAFT_ASSIST on.",
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "LCC_FLOW_SHARED_SECRET": {
      "type": "securestring",
      "defaultValue": ""
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "description": "Semicolon-delimited recipient addresses"
            },
            "cc": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "body_html": {
              "type": "string"
            },
            "in_reply_to": {
              "type": "string",
              "description": "RFC 2822 internetMessageId of the message to reply to. When non-empty the flow creates a DRAFT REPLY on that thread; when empty it creates a standalone draft."
            },
            "attachment_url": {
              "type": "string",
              "description": "Publicly fetchable URL to download + attach (optional)"
            },
            "attachment_name": {
              "type": "string"
            },
            "bcc": {
              "type": "string",
              "description": "Semicolon-delimited BCC addresses (offer-submission uses this)"
            }
          },
          "required": [
            "to",
            "subject",
            "body_html"
          ]
        }
      }
    }
  },
  "actions": {
    "Check_Shared_Secret": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "or": [
          {
            "equals": [
              "@parameters('LCC_FLOW_SHARED_SECRET')",
              ""
            ]
          },
          {
            "equals": [
              "@triggerOutputs()?['headers']?['X-LCC-Flow-Secret']",
              "@parameters('LCC_FLOW_SHARED_SECRET')"
            ]
          }
        ]
      },
      "actions": {
        "Is_Reply": {
          "runAfter": {},
          "type": "If",
          "_comment": "Empty in_reply_to => a genuine new thread => standalone draft.",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@coalesce(triggerBody()?['in_reply_to'],'')",
                    ""
                  ]
                }
              }
            ]
          },
          "actions": {
            "Find_thread_message": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "_comment": "Graph passthrough under the user's own O365 connection \u2014 no app registration. Resolves the RFC internetMessageId to the Graph message id. The id is wrapped in angle brackets in the header and MUST be single-quote-escaped for $filter.",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "Uri": "@{concat('https://graph.microsoft.com/v1.0/me/messages?$select=id,conversationId&$top=1&$filter=internetMessageId eq ''', replace(triggerBody()?['in_reply_to'],'''',''''''), '''')}",
                  "Method": "GET"
                }
              }
            },
            "Create_draft_reply": {
              "runAfter": {
                "Find_thread_message": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "_comment": "POST /createReply CREATES A DRAFT REPLY and does not transmit it. This is the only Graph call that threads correctly. Never swap it for the transmitting variant.",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "Uri": "@{concat('https://graph.microsoft.com/v1.0/me/messages/', body('Find_thread_message')?['value'][0]?['id'], '/createReply')}",
                  "Method": "POST",
                  "Body": {}
                }
              }
            },
            "Set_reply_body": {
              "runAfter": {
                "Create_draft_reply": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "_comment": "createReply seeds the draft with the quoted original; PATCH replaces the body with LCC's rendered HTML and pins the recipient. Still a draft after this.",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "Uri": "@{concat('https://graph.microsoft.com/v1.0/me/messages/', body('Create_draft_reply')?['id'])}",
                  "Method": "PATCH",
                  "Body": {
                    "body": {
                      "contentType": "HTML",
                      "content": "@{triggerBody()?['body_html']}"
                    },
                    "toRecipients": "@json(concat('[{\"emailAddress\":{\"address\":\"', triggerBody()?['to'], '\"}}]'))"
                  }
                }
              }
            },
            "Respond_Reply_Created": {
              "runAfter": {
                "Set_reply_body": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "ok": true,
                  "draft_id": "@{body('Create_draft_reply')?['id']}",
                  "web_link": "@{body('Create_draft_reply')?['webLink']}",
                  "threaded": true
                }
              }
            }
          },
          "else": {
            "actions": {
              "Create_draft": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "_comment": "Office 365 Outlook \u2192 'Create draft (V3)'. Confirm operationId in designer; map the parameters below to the action's fields. If your tenant's connector exposes 'Create event' style naming, re-select in the UI.",
                "inputs": {
                  "host": {
                    "connectionName": "shared_office365",
                    "operationId": "CreateDraftMessageV3",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                  },
                  "parameters": {
                    "emailMessage/To": "@triggerBody()?['to']",
                    "emailMessage/Cc": "@triggerBody()?['cc']",
                    "emailMessage/Subject": "@triggerBody()?['subject']",
                    "emailMessage/Body": "@triggerBody()?['body_html']",
                    "emailMessage/Importance": "Normal",
                    "emailMessage/Bcc": "@triggerBody()?['bcc']"
                  }
                }
              }
            }
          }
        },
        "Respond_Success": {
          "runAfter": {
            "Is_Reply": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "ok": true,
              "draft_id": "@{body('Create_draft')?['id']}",
              "web_link": "@{body('Create_draft')?['webLink']}"
            }
          }
        },
        "Respond_Create_Failed": {
          "runAfter": {
            "Is_Reply": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 502,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "ok": false,
              "error": "Outlook Create draft action failed"
            }
          }
        }
      },
      "else": {
        "actions": {
          "Respond_Unauthorized": {
            "runAfter": {},
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 401,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "ok": false,
                "error": "Invalid or missing X-LCC-Flow-Secret"
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}