{
  "name": "life-command-center",
  "version": "2.1.0",
  "private": true,
  "description": "Full-stack operational platform — shared team queue, inbox triage, entity management, sync orchestration",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:railway": "NODE_ENV=production node server.js",
    "dev": "node server.js",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:deploy:wait": "node scripts/verify-deploy.mjs --wait",
    "check:boot": "node scripts/check-boot.mjs",
    "lint": "eslint api/ --ext .js",
    "ai:routing": "node scripts/print-ai-chat-routing.mjs",
    "ai:status": "node scripts/ai-rollout-status.mjs",
    "ai:preview-balanced": "node scripts/preview-ai-chat-preset.mjs AI_CHAT_BALANCED_PRESET.env.example",
    "ai:preview-low-cost": "node scripts/preview-ai-chat-preset.mjs AI_CHAT_LOW_COST_PRESET.env.example",
    "ai:preview-manual": "node scripts/preview-ai-chat-preset.mjs AI_CHAT_MANUAL_EDGE_PRESET.env.example",
    "ai:apply-balanced": "node scripts/apply-ai-chat-preset.mjs AI_CHAT_BALANCED_PRESET.env.example --target .env.local",
    "ai:apply-low-cost": "node scripts/apply-ai-chat-preset.mjs AI_CHAT_LOW_COST_PRESET.env.example --target .env.local",
    "ai:apply-manual": "node scripts/apply-ai-chat-preset.mjs AI_CHAT_MANUAL_EDGE_PRESET.env.example --target .env.local",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.js test/*.test.mjs",
    "cm:refresh-catalog-snapshot": "node scripts/cm-refresh-catalog-snapshot.mjs",
    "spec:chatgpt": "node scripts/generate-chatgpt-spec.mjs",
    "healthcare:nppes:manifest": "node scripts/healthcare-discovery/cli.mjs manifest",
    "healthcare:nppes:validate": "node scripts/healthcare-discovery/cli.mjs validate",
    "healthcare:nppes:profile": "node scripts/healthcare-discovery/cli.mjs profile",
    "healthcare:nppes:load": "node scripts/healthcare-discovery/cli.mjs load",
    "healthcare:nppes:sample": "node scripts/healthcare-discovery/cli.mjs sample",
    "healthcare:nppes:verify": "node scripts/healthcare-discovery/cli.mjs verify",
    "healthcare:lane:profile": "node scripts/healthcare-discovery/lane-profile-cli.mjs",
    "healthcare:property-review:test": "node --test test/healthcare-property-review.test.mjs",
    "healthcare:run-authorization:test": "node --test test/healthcare-run-authorization.test.mjs",
    "healthcare:release-preflight:test": "node --test test/healthcare-release-packet-preflight.test.mjs",
    "healthcare:artifact-staging": "node scripts/healthcare-discovery/artifact-staging-cli.mjs",
    "healthcare:artifact-staging:test": "node --test test/healthcare-artifact-staging.test.mjs",
    "healthcare:execution-boundary": "node scripts/healthcare-discovery/execution-boundary-cli.mjs",
    "healthcare:execution-boundary:test": "node --test test/healthcare-execution-boundary.test.mjs",
    "healthcare:sample-execution": "node scripts/healthcare-discovery/sample-execution-cli.mjs",
    "healthcare:sample-execution:test": "node --test test/healthcare-sample-execution*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.0",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
