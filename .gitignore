*.docx
~$*
.env
.env.local
.env.*.local
node_modules/
__pycache__/
*.pyc
.vercel/
.tmp_flow_audit/

.env*.local

# availability-checker acceptance test — local-only, may contain
# sensitive broker URLs and results. See docs/availability_checker_acceptance.md.
scripts/availability-checker-samples.json
scripts/availability-checker-samples.results.json

# Supabase CLI local state. Created by `supabase link` /
# `supabase functions deploy`; encodes the operator's machine state
# (linked project ref, CLI version cache) and shouldn't be in git.
supabase/.temp/

# Local production integration exports. Power Automate packages may contain
# tenant, endpoint, connection-reference, or secret metadata. Keep the raw
# packages beside the architecture docs for local AI review, but never commit.
/private/power-automate/
/private/healthcare-discovery/


# QA-32: prevent truncation-investigation artifacts from leaking back
audit/lcc-*-test*.txt
audit/edit-tool-test.*

# Ownership/Sales remediation snapshots (gitignored — local-only DB dumps,
# may contain PII; produced by scripts/audit/snapshots/snapshot-take.mjs).
scripts/audit/snapshots/*.sql
scripts/audit/snapshots/*.sql.gz

# SF deal-level exports (do not commit — PII/deal data)
docs/capital-markets/sf-exports/
*.xlsx

# Repo-root cleanup (2026-07): keep one-off data/report artifacts out of git.
# Root-level CSVs are throwaway audit/report dumps (some very large) — never commit.
/*.csv
# Compressed archives / tarballs.
*.tar.gz
# Ad-hoc scratch/quarantine directory.
_to_delete/
# Runtime logs.
logs/
# Personal mailbox exports — never commit. A 475 MB
# email_export/sabriggs@northmarq.com.pst was committed 2026-08-19 and GitHub's
# pre-receive hook rejected the push (100 MB limit). Beyond size, a .pst is
# personal correspondence and does not belong in a code repo at all.
email_export/
*.pst
*.ost
